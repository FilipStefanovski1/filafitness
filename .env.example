# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...            # used only by scripts/invite.ts and the demo seed
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
APP_URL=https://<your-app>.vercel.app          # public origin; used as the OAuth issuer for MCP
